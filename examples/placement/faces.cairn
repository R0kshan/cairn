diagram logical "Claims handling — flow attachment faces"

# Baseline shape, shared by every file in this directory so the effect of a
# `layout` block is the only thing that differs between them.
# See documentation/DSL_SPEC.md #13-influencing-placement

actor-group TEAM "Operations team" {
  actor AGENT "Claims agent"
}

system INTAKE  "Claim intake"         { block RECEIVE "Claim reception module" }
system ROUTING "Claim routing"        { block ASSIGN  "Assignment module" }
system AUDIT   "Audit trail"          { block TRACE   "Traceability module" }
system ARCHIVE "Claim archive"        { block STORE   "Document storage module" }
system REPORT  "Management reporting" { block DASH    "Reporting dashboard" }

external PARTNER "Partner network" { block SETTLE "Settlement service" }

# Each flow below names the box faces it uses. `from` and `to` are
# independent — name one and the engine still chooses the other.

AGENT   -> RECEIVE : "File a claim"
RECEIVE -> ASSIGN  : "Route for assignment" { from: south to: north }
ASSIGN  -> SETTLE  : "Request settlement" { from: east }
AGENT   -> TRACE   : "Consult the audit trail"
TRACE   -> STORE   : "Archive the trace" { from: north to: south }
AGENT   -> DASH    : "Open the dashboard" { to: west }
