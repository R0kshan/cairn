diagram application "Information voyageurs d'une ligne — vue applicative"
style {
  lang: fr
  disposition: wide
}

# ============================================================================
# CENTRE DE SUPERVISION (SYS_CENTRE)
# ============================================================================
auth AUTH_CENTRE "Reverse proxy\n(OIDC)"
idp IDP_GROUPE "SSO du groupe"

application POSTE_CENTRE "Poste opérateur\nau centre"
application POSTE_STATION "Poste opérateur\nen station"
application IHM_CENTRE "IHM\ncentre" { logo: angular }
application AFFICHEURS "Afficheurs\nde quai"

datastore BDD_CENTRE "Base centrale" { logo: postgresql }

# Modules du backend centre
application BACK_CENTRE "Backend centre" {
  logo: spring
  module MOD_SUIVI_CENTRE "Suivi des circulations\ncentre"
  module MOD_MSG_CENTRE "Messagerie\ncentre"
  module MOD_DONNEES_CENTRE "Gestion des données"
  module MOD_SYSTEME_CENTRE "Gestion du système"
}

# ============================================================================
# FILES DE MESSAGES
# ============================================================================
queue Q_TEMPS_REEL_CENTRE "CENTRE_TEMPS_REEL"
queue Q_TEMPS_REEL_TIERS "TIERS_TEMPS_REEL"
queue Q_NOTIF_TRAFIC "NOTIF_TRAFIC"
queue Q_CENTRE_SUIVI "CENTRE_SUIVI"
queue Q_STATION_SUIVI "STATION_SUIVI"

# ============================================================================
# SYSTÈME EN STATION (SYS_STATION)
# ============================================================================
application BACK_STATION "Backend station" {
  logo: spring
  module MOD_IHM_STATION "IHM station"
  module MOD_SUIVI_STATION "Suivi des circulations\nstation"
  module MOD_MSG_STATION "Messagerie\nstation"
  module MOD_SECURITE "Sécurité\napplicative"
}

# ============================================================================
# SYSTÈMES TIERS INTERFACÉS
# ============================================================================
external SI_TIERS "SI tiers" {
  external SUPERVISION_TIERS "Supervision des\ncirculations"
  external PREVISION "Prévision de\ncirculation"
  external NOTIF_TRAFIC "Notification\ntrafic"
  external AFFICHAGE_DEST "Affichage des\ndestinations"
}

# ============================================================================
# FLUX
# ============================================================================

# Flux entre IHM centre et backend centre
POSTE_CENTRE -> AUTH_CENTRE (HTTPS)
AUTH_CENTRE -> IDP_GROUPE (HTTPS)
AUTH_CENTRE -> IHM_CENTRE (HTTPS)
IHM_CENTRE -> MOD_SYSTEME_CENTRE (HTTPS/REST)
IHM_CENTRE -> MOD_MSG_CENTRE (HTTPS/REST)
MOD_MSG_CENTRE -> IHM_CENTRE (SSE)
MOD_SYSTEME_CENTRE -> IHM_CENTRE (SSE)
POSTE_STATION -> MOD_SECURITE (HTTPS)
MOD_SECURITE -> IDP_GROUPE (OIDC, JWT)
MOD_SECURITE -> MOD_IHM_STATION (HTTPS)

# Flux entre modules du backend centre
MOD_SUIVI_CENTRE -> MOD_MSG_CENTRE (in-process)
MOD_SUIVI_CENTRE -> MOD_DONNEES_CENTRE (in-process)
MOD_DONNEES_CENTRE -> BDD_CENTRE (TCP/IP)

# Flux entre backend centre et SI tiers
SUPERVISION_TIERS -> MOD_SUIVI_CENTRE (HTTPS/REST)
PREVISION -> Q_TEMPS_REEL_TIERS.left (AMQP/topic)
MOD_MSG_CENTRE -> Q_TEMPS_REEL_TIERS.right (AMQP/topic)
MOD_DONNEES_CENTRE -> Q_TEMPS_REEL_CENTRE (AMQP/fanout)
NOTIF_TRAFIC -> Q_TEMPS_REEL_CENTRE (AMQP/fanout)

# Flux centre <-> station (via files de messages)
MOD_MSG_CENTRE -> Q_CENTRE_SUIVI.left (AMQP/direct)
MOD_MSG_STATION -> Q_CENTRE_SUIVI.right (AMQP/direct)
MOD_MSG_STATION -> Q_STATION_SUIVI.left (AMQP/direct)
MOD_MSG_CENTRE -> Q_STATION_SUIVI.right (AMQP/direct)
MOD_MSG_STATION -> MOD_MSG_CENTRE (HTTP/REST)

# Flux entre modules du backend station
MOD_SUIVI_STATION -> MOD_MSG_STATION (in-process)
MOD_MSG_STATION -> MOD_IHM_STATION (SSE)
MOD_SUIVI_STATION -> AFFICHEURS (RS422)
MOD_IHM_STATION -> MOD_MSG_STATION (in-process)

# Flux entre backend station et SI tiers
AFFICHAGE_DEST -> MOD_SUIVI_STATION (TCP/Socket)
NOTIF_TRAFIC -> Q_NOTIF_TRAFIC (AMQP/fanout)
MOD_MSG_STATION -> Q_NOTIF_TRAFIC (AMQP/fanout)
