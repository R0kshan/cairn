diagram application "Information voyageurs d'une ligne — vue applicative"
style {
  lang: fr
  disposition: slide
  flow-text: numbered
}

# ============================================================================
# CENTRE DE SUPERVISION
#
# Trois leviers combattent le vide de cette vue :
#   1. `system` — les composants du centre tiennent dans une seule frontière C4,
#      donc elk les empile dans une région au lieu de leur donner une bande
#      chacun (c'est ce qui faisait un ruban de dix colonnes) ;
#   2. `disposition: slide` — cible le 16:9 au lieu de la bannière ;
#   3. `flow-text: numbered` — les flèches ne portent qu'un numéro, les
#      protocoles descendent dans la table sous le dessin : les couloirs de
#      libellés, qui fixaient l'écartement des colonnes, disparaissent.
#
# `order:` empile de haut en bas dans un conteneur, et fixe la bande de lecture
# à la racine. Les valeurs ci-dessous sont choisies par mesure (sweep), pas par
# sémantique : la station est en bande 3 avec les files parce que c'est là que
# les croisements tombent à 10.
# ============================================================================
system SYS_CENTRE "Système centre" { order: 1
  auth AUTH_CENTRE "Reverse proxy\n(OIDC)" { order: 2 }
  idp IDP_GROUPE "SSO du groupe" { order: 3 }
  application POSTE_CENTRE "Poste opérateur\nau centre" { order: 1 }
  application IHM_CENTRE "IHM\ncentre" { logo: angular order: 4 }
  application BACK_CENTRE "Backend centre" {
    logo: spring
    order: 5
    module MOD_SUIVI_CENTRE "Suivi des circulations\ncentre" { order: 4 }
    module MOD_MSG_CENTRE "Messagerie\ncentre" { order: 2 }
    module MOD_DONNEES_CENTRE "Gestion des données" { order: 1 }
    module MOD_SYSTEME_CENTRE "Gestion du système" { order: 3 }
  }
  datastore BDD_CENTRE "Base centrale" { logo: postgresql order: 6 }
}

# ============================================================================
# FILES DE MESSAGES — partagées par les deux zones, donc à la racine
# ============================================================================
queue Q_TEMPS_REEL_CENTRE "CENTRE_TEMPS_REEL" { order: 3 }
queue Q_TEMPS_REEL_TIERS "TIERS_TEMPS_REEL" { order: 3 }
queue Q_NOTIF_TRAFIC "NOTIF_TRAFIC" { order: 3 }
queue Q_CENTRE_SUIVI "CENTRE_SUIVI" { order: 3 }
queue Q_STATION_SUIVI "STATION_SUIVI" { order: 3 }

# ============================================================================
# SYSTÈME EN STATION
#
# La station reste à plat : mesuré, regrouper les deux zones dans deux `system`
# fait passer les croisements de 13 à 57 — les flux centre <-> station doivent
# alors contourner deux grandes boîtes au lieu d'une.
# ============================================================================
  application POSTE_STATION "Poste opérateur\nen station" { order: 3 }
application BACK_STATION "Backend station" {
  logo: spring
  order: 3
  module MOD_IHM_STATION "IHM station" { order: 3 }
  module MOD_SUIVI_STATION "Suivi des circulations\nstation" { order: 1 }
  module MOD_MSG_STATION "Messagerie\nstation" { order: 2 }
  module MOD_SECURITE "Sécurité\napplicative" { order: 4 }
}
application AFFICHEURS "Afficheurs\nde quai" { order: 2 }

# ============================================================================
# SYSTÈMES TIERS INTERFACÉS
# ============================================================================
external SI_TIERS "SI tiers" {
  external SUPERVISION_TIERS "Supervision des\ncirculations"
  external PREVISION "Prévision de\ncirculation"
  external NOTIF_TRAFIC "Notification\ntrafic"
  external AFFICHAGE_DEST "Affichage des\ndestinations"
}

# ============================================================================
# FLUX
# ============================================================================

# Flux entre IHM centre et backend centre
POSTE_CENTRE -> AUTH_CENTRE (HTTPS)
AUTH_CENTRE -> IDP_GROUPE (HTTPS)
AUTH_CENTRE -> IHM_CENTRE (HTTPS)
IHM_CENTRE -> MOD_SYSTEME_CENTRE (HTTPS/REST)
IHM_CENTRE -> MOD_MSG_CENTRE (HTTPS/REST)
MOD_MSG_CENTRE -> IHM_CENTRE (SSE)
MOD_SYSTEME_CENTRE -> IHM_CENTRE (SSE)
POSTE_STATION -> MOD_SECURITE (HTTPS)
MOD_SECURITE -> IDP_GROUPE (OIDC, JWT)
MOD_SECURITE -> MOD_IHM_STATION (HTTPS)

# Flux entre modules du backend centre
MOD_SUIVI_CENTRE -> MOD_MSG_CENTRE (in-process)
MOD_SUIVI_CENTRE -> MOD_DONNEES_CENTRE (in-process)
MOD_DONNEES_CENTRE -> BDD_CENTRE (TCP/IP)

# Flux entre backend centre et SI tiers
# Le SI tiers est à droite : la supervision entre par le haut du module plutôt
# que de traverser le backend.
SUPERVISION_TIERS.left -> MOD_SUIVI_CENTRE.top (HTTPS/REST)
PREVISION -> Q_TEMPS_REEL_TIERS.right (AMQP/topic)
MOD_MSG_CENTRE -> Q_TEMPS_REEL_TIERS.left (AMQP/topic)
MOD_DONNEES_CENTRE -> Q_TEMPS_REEL_CENTRE (AMQP/fanout)
NOTIF_TRAFIC -> Q_TEMPS_REEL_CENTRE (AMQP/fanout)

# Flux centre <-> station (via files de messages)
# Les côtés épinglés suivent l'axe de lecture : le backend centre (bande 50)
# aborde la file par la gauche, le backend station (bande 80) par la droite.
# Épinglées seulement là où le routage automatique se croisait.
MOD_MSG_CENTRE -> Q_CENTRE_SUIVI (AMQP/direct)
MOD_MSG_STATION -> Q_CENTRE_SUIVI (AMQP/direct)
MOD_MSG_STATION -> Q_STATION_SUIVI.right (AMQP/direct)
MOD_MSG_CENTRE -> Q_STATION_SUIVI.left (AMQP/direct)
MOD_MSG_STATION -> MOD_MSG_CENTRE (HTTP/REST)

# Flux entre modules du backend station
MOD_SUIVI_STATION -> MOD_MSG_STATION (in-process)
MOD_MSG_STATION -> MOD_IHM_STATION (SSE)
MOD_SUIVI_STATION -> AFFICHEURS (RS422)
MOD_IHM_STATION -> MOD_MSG_STATION (in-process)

# Flux entre backend station et SI tiers
AFFICHAGE_DEST -> MOD_SUIVI_STATION (TCP/Socket)
NOTIF_TRAFIC -> Q_NOTIF_TRAFIC.right (AMQP/fanout)
MOD_MSG_STATION -> Q_NOTIF_TRAFIC.left (AMQP/fanout)
