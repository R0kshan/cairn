diagram application "E-commerce platform — application view"
style {
  stroke external: #b33 dashed 1.5
}

actor-group TEAMS "Internal teams" {
  actor MERCH "Merchandising\nmanager"
  actor ADVISOR "Customer-relations\nadvisor"
  actor ACCOUNTANT "Accountant"
}

application FRONT "Sales front" { logo: nextdotjs
  module SITE "E-commerce\nsite" { logo: react }
  module APP_MOBILE "Mobile\napp" { logo: typescript }
  module CHECKOUT "Checkout\nfunnel" { logo: nodedotjs }
}

application OMS "Order management" { logo: spring
  module ORDERS "Order\nlifecycle" { logo: openjdk }
  module SHIPPING "Shipment\norchestration"
  module RETURNS "Returns and\nrefunds"
}

application PIM "Product repository" { logo: django
  module CATALOG "Catalog\nmanagement"
  module MEDIA "Media\nmanagement"
}

application PRICING "Pricing" { logo: python
  module RULES "Pricing-rule\nengine" { logo: fastapi }
}

application PAYHUB "Payment hub" { logo: go
  module PAY_ORCH "Payment\norchestration"
  module FRAUD "Anti-fraud\nscoring" { logo: python }
}

application CARE "Customer care" { logo: nodedotjs
  module TICKETS "Ticket\nmanagement"
  module SELFCARE "Customer\nself-care" { logo: react }
}

queue EVENTS "Order\nevent bus" { logo: apachekafka }

datastore DWH "Data\nwarehouse" { logo: postgresql }
datastore REF_CUSTOMERS "Customer\nrepository" { logo: mongodb }

external PSP "PSP"
external CARRIERS "Carrier\nplatforms"
external ERP "Group\nERP"


# ---- flows ----
MERCH -> CATALOG
CATALOG -> SITE (API_REST, JSON)
MEDIA -> SITE (CDN, HTTPS)
RULES -> SITE (API_REST, JSON)
RULES -> CHECKOUT (API_REST, JSON)
ERP -> RULES (SFTP, CSV)
SITE -> CHECKOUT (local call)
APP_MOBILE -> CHECKOUT (API_REST, JSON)
CHECKOUT -> ORDERS (MQ, JSON)
CHECKOUT -> PAY_ORCH (API_REST, JSON)
PAY_ORCH -> FRAUD (local call)
PAY_ORCH -> PSP (API_REST, JSON)
PSP -> PAY_ORCH (webhook, JSON)
PAY_ORCH -> ORDERS (MQ, JSON)
ORDERS -> SHIPPING (local call)
SHIPPING -> CARRIERS (API_REST, JSON)
CARRIERS -> SHIPPING (webhook, JSON)
SHIPPING -> EVENTS (MQ, JSON)
SELFCARE -> EVENTS.right (MQ, JSON)
ADVISOR -> TICKETS
TICKETS -> RETURNS (API_REST, JSON)
RETURNS -> PAY_ORCH (MQ, JSON)
SELFCARE -> REF_CUSTOMERS (JDBC)
ORDERS -> DWH (batch, parquet)
SITE -> DWH (streaming, avro)
ACCOUNTANT -> PAY_ORCH
ERP -> ORDERS (MQ, JSON)
