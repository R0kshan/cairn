diagram application "Leave portal — application view"
style {
  stroke external: #b33 dashed 1.5
}

actor-group HR "HR actors" {
  actor EMPLOYEE "Employee"
  actor MANAGER "Manager"
}

# `system` is a C4 system boundary: it groups the applications, queues and
# datastores that belong to one system.
system HRIS "HR information system" {
  application PORTAL "HR portal" { logo: spring
    module LEAVE "Leave\nrequests" { logo: openjdk }
    module APPROVAL "Approval\nworkflow" { logo: openjdk }
  }

  queue NOTIFY "Notification\nbus" { logo: rabbitmq }

  datastore HR_REF "HR\nrepository" { logo: postgresql }
}

external PAYROLL "Payroll HRIS\n(outsourced)"


EMPLOYEE -> LEAVE
LEAVE -> APPROVAL (API_REST, JSON)
MANAGER -> APPROVAL
APPROVAL -> HR_REF (JDBC)
APPROVAL -> NOTIFY (MQ, JSON)
LEAVE -> NOTIFY.right (MQ, JSON)
APPROVAL -> PAYROLL (SFTP, CSV)
