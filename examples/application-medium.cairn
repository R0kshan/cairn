diagram application "Billing management — application view (extended, with tax calculation)"
style {
  stroke external: #b33 dashed 1.5
}

actor-group MANAGERS "Managers" {
  actor ACCOUNTANT "Accountant"
  actor SALES_ADMIN "Sales\nadministration"
}

application CRM "CRM" { logo: dotnet
  module CRM_ACCOUNTS "Customer-account\nmanagement"
  module CRM_CONTRACTS "Contract\nmanagement"
}

application BILLING "Billing" { logo: spring
  module BILL_ENGINE "Billing\nengine" { logo: openjdk }
  module BILL_ISSUE "Invoice issuing\nand sending"
  module BILL_DUNNING "Dunning and\ncollection"
  module TAX "Tax\ncalculation" { logo: python }
}

application ACCOUNTING "Accounting" { logo: openjdk
  module GL "General ledger"
  module AR "Accounts\nreceivable"
}

queue EVENTS "Billing\nevent bus" { logo: apachekafka }

datastore REF_CUSTOMERS "Customer\nrepository" { logo: postgresql }
datastore REF_OFFERS "Offer\ncatalog" { logo: mongodb }

external EDI "Partner EDI\nplatform"
external PPF "Electronic-invoicing\nportal (PPF)"


# ---- application flows: label (protocol, format) ----
SALES_ADMIN -> CRM_CONTRACTS
CRM_ACCOUNTS -> REF_CUSTOMERS (API_REST, JSON)
CRM_CONTRACTS -> BILL_ENGINE (MQ, JSON)
REF_OFFERS -> BILL_ENGINE (JDBC)
BILL_ENGINE -> TAX (REST, JSON)
TAX -> BILL_ISSUE (REST, JSON)
BILL_ENGINE -> EVENTS (MQ, JSON)
BILL_ISSUE -> EVENTS.right (MQ, JSON)
BILL_ISSUE -> EDI (AS4, UBL)
BILL_ISSUE -> PPF (API_REST, FacturX)
BILL_ISSUE -> AR (MQ, JSON)
BILL_DUNNING -> CRM_ACCOUNTS (API_REST, JSON)
AR -> GL (batch, CSV)
ACCOUNTANT -> GL
ACCOUNTANT -> BILL_DUNNING

legend {
  note "Factur-X mandatory since the electronic-invoicing reform"
}
