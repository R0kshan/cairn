diagram application "Billing platform — API edge (gateway, authentication, identity)"
style {
  disposition: wide
}

# ============================================================================
# CONSUMERS
# ============================================================================
actor-group CONSUMERS "External consumers" {
  actor PARTNER "Partner\nintegrator"
  actor MOBILE "Mobile\nclient"
}

# ============================================================================
# API EDGE
# Every call from outside crosses the gateway, then the auth middleware, which
# validates the token against the group's own identity provider. All three kinds
# are shared with the infrastructure view and drawn the same way there — the
# difference is what they stand for: here they are containers in the C4 sense,
# not boxes on a network path.
# ============================================================================
gateway EDGE "Public API\ngateway" { order: 1 }
auth SSO "OAuth2\nmiddleware" { order: 2 }

# ============================================================================
# BILLING SYSTEM
# ============================================================================
system BILLING_SYS "Billing system" { order: 3
  application BILLING "Billing" { logo: spring
    module BILL_ENGINE "Billing\nengine"
    module BILL_ISSUE "Invoice issuing\nand sending"
  }
  datastore REF_CUSTOMERS "Customer\nrepository" { logo: postgresql }
}

# `idp` is for a provider that belongs to the landscape being described — the
# group's own SSO, a self-hosted Keycloak. One owned by somebody else stays an
# `external`, the way any third party is drawn.
idp SSO_IDP "Group SSO\nprovider" { order: 4 }

external PSP "Payment service\nprovider (third party)"

# ============================================================================
# FLOWS — the edge is the only way in
# ============================================================================
PARTNER -> EDGE
MOBILE -> EDGE
EDGE -> SSO (API_REST, JSON)
SSO -> SSO_IDP (OIDC, JWT)
EDGE -> BILL_ENGINE (API_REST, JSON)
EDGE -> BILL_ISSUE (API_REST, JSON)
BILL_ENGINE -> REF_CUSTOMERS (JDBC)
BILL_ISSUE -> PSP (API_REST, JSON)
