diagram application "Claims platform — attachment sides"

# Every attachment side, on both ends of a flow and on one end alone.
# Sides are named as the diagram is read: left, right, top, bottom.

actor-group AGENTS "Claims actors" {
  actor HANDLER "Claims handler"
}

system CLAIMS "Claims platform" {
  application INTAKE_APP "Claim intake" {
    module FORM "Claim\nform"
    module TRIAGE "Triage"
  }
  application ASSESS_APP "Assessment" {
    module SCORING "Risk\nscoring"
  }
  queue TASKS "Task\nqueue"
  datastore CLAIM_DB "Claim\nstore"
  datastore AUDIT_DB "Audit\nlog"
}

external REINSURER "Reinsurer\n(external)"

HANDLER -> FORM (API_REST, JSON)
FORM.right -> TRIAGE.left (API_REST, JSON)
TRIAGE.bottom -> CLAIM_DB.top (JDBC)
TRIAGE -> TASKS.left (MQ, JSON)
TASKS -> SCORING (MQ, JSON)
SCORING.bottom -> AUDIT_DB.top (JDBC)
SCORING --> REINSURER (SFTP, CSV)
TRIAGE ..> REINSURER (API_REST, JSON)
FORM --> AUDIT_DB (JDBC) { stroke: solid }
# A backward flow, pinned on both ends: top on the source, right on the target.
SCORING.top -> TRIAGE.right (API_REST, JSON)
