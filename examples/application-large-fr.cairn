diagram application "Plateforme e-commerce — vue applicative"
style {
  lang: fr
  stroke external: #b33 dashed 1.5
}

actor-group TEAMS "Équipes internes" {
  actor MERCH "Responsable\nmerchandising"
  actor ADVISOR "Conseiller relation\nclient"
  actor ACCOUNTANT "Comptable"
}

application FRONT "Front de vente" { logo: nextdotjs
  module SITE "Site\ne-commerce" { logo: react }
  module APP_MOBILE "Application\nmobile" { logo: typescript }
  module CHECKOUT "Tunnel\nd'achat" { logo: nodedotjs }
}

application OMS "Gestion des commandes" { logo: spring
  module ORDERS "Cycle de vie\ndes commandes" { logo: openjdk }
  module SHIPPING "Orchestration des\nexpéditions"
  module RETURNS "Retours et\nremboursements"
}

application PIM "Référentiel produits" { logo: django
  module CATALOG "Gestion du\ncatalogue"
  module MEDIA "Gestion des\nmédias"
}

application PRICING "Tarification" { logo: python
  module RULES "Moteur de règles\nde prix" { logo: fastapi }
}

application PAYHUB "Hub de paiement" { logo: go
  module PAY_ORCH "Orchestration des\npaiements"
  module FRAUD "Scoring\nanti-fraude" { logo: python }
}

application CARE "Relation client" { logo: nodedotjs
  module TICKETS "Gestion des\ntickets"
  module SELFCARE "Espace client\nautonome" { logo: react }
}

queue EVENTS "Bus d'événements\ncommandes" { logo: apachekafka }

datastore DWH "Entrepôt de\ndonnées" { logo: postgresql }
datastore REF_CUSTOMERS "Référentiel\nclients" { logo: mongodb }

external PSP "PSP"
external CARRIERS "Plateformes\ntransporteurs"
external ERP "ERP\ngroupe"


# ---- flux ----
MERCH -> CATALOG
CATALOG -> SITE (API_REST, JSON)
MEDIA -> SITE (CDN, HTTPS)
RULES -> SITE (API_REST, JSON)
RULES -> CHECKOUT (API_REST, JSON)
ERP -> RULES (SFTP, CSV)
SITE -> CHECKOUT (REST)
APP_MOBILE -> CHECKOUT (API_REST, JSON)
CHECKOUT -> ORDERS (MQ, JSON)
CHECKOUT -> PAY_ORCH (API_REST, JSON)
PAY_ORCH -> FRAUD (REST)
PAY_ORCH -> PSP (API_REST, JSON)
PSP -> PAY_ORCH (webhook, JSON)
PAY_ORCH -> ORDERS (MQ, JSON)
ORDERS -> SHIPPING (REST)
SHIPPING -> CARRIERS (API_REST, JSON)
CARRIERS -> SHIPPING (webhook, JSON)
SHIPPING -> EVENTS (MQ, JSON)
SELFCARE -> EVENTS.right (MQ, JSON)
ADVISOR -> TICKETS
TICKETS -> RETURNS (API_REST, JSON)
RETURNS -> PAY_ORCH (MQ, JSON)
SELFCARE -> REF_CUSTOMERS (JDBC)
ORDERS -> DWH (batch, parquet)
SITE -> DWH (streaming, avro)
ACCOUNTANT -> PAY_ORCH
ERP -> ORDERS (MQ, JSON)
