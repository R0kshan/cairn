node_modules/
dist/
# npm package bundles — built by `npm run build:package` / `prepack`, never
# committed. Root-anchored: playground/lib/ IS committed (Vercel has no build
# step), so a bare `lib/` would swallow it.
/lib/

*.log
*.bun-build
bun.lock

.opencode/*
!.opencode/skills

.claude/*
!.claude/skills
.vercel
.env*
.tmp/
